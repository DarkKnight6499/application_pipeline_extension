{
  "manifest_version": 3,
  "name": "Resume Portal Prototype",
  "version": "0.5.0",
  "description": "Review and fill selected application fields using the local resume pipeline.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Review application fields"}
}
